# Base URL of the API server (include /api)
VITE_API_URL=http://localhost:5000/api
# Brand name shown in the navbar, footer, intro splash and page title
VITE_APP_NAME=Imperial Air Charter
# Optional compact name for the navbar (defaults to the first two words of VITE_APP_NAME)
# VITE_APP_SHORT_NAME=Imperial Air

# Optional: hero background clips, comma-separated (e.g. /videos/jet-1.mp4,/videos/heli-1.mp4)
VITE_HERO_VIDEOS=

# Optional public contact details shown next to the enquiry form
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Optional: Sentry DSN for frontend error tracking (https://sentry.io). Leave empty to disable.
VITE_SENTRY_DSN=

# Optional company disclosures shown in the footer to build buyer trust (all three are optional)
# VITE_COMPANY_LEGAL_NAME=Imperial Air Charter Private Limited
# VITE_COMPANY_ADDRESS=Registered office address
# VITE_COMPANY_REG=CIN / GSTIN / AOC partner reference
